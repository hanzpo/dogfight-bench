{
  "name": "dogfight-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node tools/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env server/node.ts",
    "dev:online": "mkdir -p dist && npx wrangler@4 dev --port 8788",
    "check:online": "tsx tools/online/smoke.ts",
    "server": "tsx --env-file-if-exists=.env server/node.ts",
    "bench": "tsx --env-file-if-exists=.env server/cli.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ui": "tsx tools/ui-check/check.ts",
    "check:ui:fast": "UI_CHECK_ENGINES=webkit UI_CHECK_SKIP_ACCOUNT=1 tsx tools/ui-check/check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@hono/node-server": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.116.0",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.180.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
