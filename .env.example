# Browser configuration. Everything with a VITE_ prefix is compiled into the
# bundle and served to everyone, so only values that are public by design may
# appear here. The publishable key grants nothing beyond acting as whoever is
# signed in; the server verifies every token with Supabase rather than trusting
# it.
VITE_SUPABASE_URL=https://gwvlpiadxhmghrnjbrll.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_SjQ3x3Ph9SOlAxtzb1XF-A_Lb4ZLolU

# Server configuration. None of this reaches the browser.
SUPABASE_URL=https://gwvlpiadxhmghrnjbrll.supabase.co
SUPABASE_ANON_KEY=sb_publishable_SjQ3x3Ph9SOlAxtzb1XF-A_Lb4ZLolU
# Bypasses row level security: it is the only thing that may write results.
# Dashboard -> Project Settings -> API -> service_role. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Providers. The public tier runs on TYPESAFE_API_KEY; everything else expects
# the person flying to supply their own key in the UI.
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which providers anyone may use without a key, and what that is allowed to cost.
DOGFIGHT_PUBLIC_PROVIDERS=jev,jev-stick
DOGFIGHT_PUBLIC_DAILY_USD=5

# Required before /api/matches will run a paid series on a public host.
DOGFIGHT_API_TOKEN=
